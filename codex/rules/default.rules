prefix_rule(pattern=["/bin/zsh", "-lc", "mise exec -- pnpm exec biome check --write apps/analyzer/src/analyze.test.ts && DATABASE_URL=postgres://memefinder:memefinder@127.0.0.1:5432/memefinder_codex_test mise exec -- pnpm exec vitest run apps/analyzer/src/analyze.test.ts apps/notifier/src/notify.test.ts apps/scraper/src/security/robinhood.db.test.ts"], decision="allow")
prefix_rule(pattern=["mise", "exec", "--", "node", "--input-type=module", "-e", "import pg from \"pg\"; const c=new pg.Client({connectionString:\"postgres://memefinder:memefinder@127.0.0.1:5432/memefinder\"}); await c.connect(); const q=`with refs as (select id,symbol,ca from coins where chain = $1 and ca = any($2::text[])), per_coin as (select r.symbol,r.ca,count(*)::int as trades,count(distinct wat.wallet_id)::int as wallets,count(*) filter (where wat.side=$3)::int as buys,count(*) filter (where wat.side=$4)::int as sells,min(wat.occurred_at) as first_trade_at,max(wat.occurred_at) as last_trade_at from refs r left join wallet_asset_trades wat on wat.coin_id=r.id group by r.symbol,r.ca), overlap as (select count(*)::int as wallets_in_both from (select wat.wallet_id from wallet_asset_trades wat join refs r on r.id=wat.coin_id group by wat.wallet_id having count(distinct wat.coin_id)=2) x), labels as (select wl.role,wl.status,count(*)::int rows,count(distinct wl.wallet_id)::int wallets from wallet_labels wl join refs r on r.id=wl.reference_coin_id group by wl.role,wl.status order by wl.role,wl.status) select json_build_object($5,(select json_agg(per_coin order by symbol) from per_coin),$6,(select row_to_json(overlap) from overlap),$7,(select json_agg(labels) from labels)) as result`; const r=await c.query(q,[\"robinhood\",[\"0x020bfc650a365f8bb26819deaabf3e21291018b4\",\"0x9e93ea35be23ab0e1e20ed6b62d3b1cbd5234a83\"],\"buy\",\"sell\",\"perCoin\",\"overlap\",\"labels\"]); console.log(JSON.stringify(r.rows[0].result,null,2)); await c.end();"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "DATABASE_URL=postgres://memefinder:memefinder@127.0.0.1:5432/memefinder_codex_test mise exec -- pnpm exec vitest run apps/scraper/src/wallets/early-investors.db.test.ts"], decision="allow")
