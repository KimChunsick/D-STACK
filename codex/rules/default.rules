prefix_rule(pattern=["mise", "exec", "--", "node", "--input-type=module", "-e", "import pg from \"pg\"; const c=new pg.Client({connectionString:\"postgres://memefinder:memefinder@127.0.0.1:5432/memefinder\"}); await c.connect(); const q=`with refs as (select id,symbol,ca from coins where chain = $1 and ca = any($2::text[])), per_coin as (select r.symbol,r.ca,count(wat.id)::int as trades,count(distinct wat.wallet_id)::int as wallets,count(*) filter (where wat.side=$3)::int as buys,count(*) filter (where wat.side=$4)::int as sells,min(wat.occurred_at) as first_trade_at,max(wat.occurred_at) as last_trade_at from refs r left join wallet_asset_trades wat on wat.coin_id=r.id group by r.symbol,r.ca), overlap as (select count(*)::int as wallets_in_both from (select wat.wallet_id from wallet_asset_trades wat join refs r on r.id=wat.coin_id group by wat.wallet_id having count(distinct wat.coin_id)=2) x), labels as (select wl.role,wl.status,count(*)::int rows,count(distinct wl.wallet_id)::int wallets from wallet_labels wl join refs r on r.id=wl.reference_coin_id group by wl.role,wl.status order by wl.role,wl.status) select json_build_object(perCoin,(select json_agg(per_coin order by symbol) from per_coin),overlap,(select row_to_json(overlap) from overlap),labels,(select json_agg(labels) from labels)) as result`; const r=await c.query(q,[\"robinhood\",[\"0x020bfc650a365f8bb26819deaabf3e21291018b4\",\"0x9e93ea35be23ab0e1e20ed6b62d3b1cbd5234a83\"],\"buy\",\"sell\"]); console.log(JSON.stringify(r.rows[0].result,null,2)); await c.end();"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "DATABASE_URL=postgres://memefinder:memefinder@127.0.0.1:5432/memefinder_codex_test mise exec -- pnpm exec vitest run apps/scraper/src/wallets/early-investors.test.ts apps/scraper/src/wallets/early-investors.db.test.ts"], decision="allow")
prefix_rule(pattern=["mise", "exec", "--", "node", "--input-type=module", "-e", "import pg from \"pg\"; const c=new pg.Client({connectionString:\"postgres://memefinder:memefinder@127.0.0.1:5432/memefinder\"}); await c.connect(); const q=`with refs as (select id,symbol,ca from coins where chain = $1 and ca = any($2::text[])), per_coin as (select r.symbol,r.ca,count(wat.id)::int as trades,count(distinct wat.wallet_id)::int as wallets,count(*) filter (where wat.side=$3)::int as buys,count(*) filter (where wat.side=$4)::int as sells,min(wat.occurred_at) as first_trade_at,max(wat.occurred_at) as last_trade_at from refs r left join wallet_asset_trades wat on wat.coin_id=r.id group by r.symbol,r.ca), overlap as (select count(*)::int as wallets_in_both from (select wat.wallet_id from wallet_asset_trades wat join refs r on r.id=wat.coin_id group by wat.wallet_id having count(distinct wat.coin_id)=2) x), labels as (select wl.role,wl.status,count(*)::int rows,count(distinct wl.wallet_id)::int wallets from wallet_labels wl join refs r on r.id=wl.reference_coin_id group by wl.role,wl.status order by wl.role,wl.status) select json_build_object($5::text,(select json_agg(per_coin order by symbol) from per_coin),$6::text,(select row_to_json(overlap) from overlap),$7::text,(select json_agg(labels) from labels)) as result`; const r=await c.query(q,[\"robinhood\",[\"0x020bfc650a365f8bb26819deaabf3e21291018b4\",\"0x9e93ea35be23ab0e1e20ed6b62d3b1cbd5234a83\"],\"buy\",\"sell\",\"perCoin\",\"overlap\",\"labels\"]); console.log(JSON.stringify(r.rows[0].result,null,2)); await c.end();"], decision="allow")
prefix_rule(pattern=["mise", "exec", "--", "node", "--input-type=module", "-e", "import { loadConfig } from \"./packages/config/dist/index.js\"; import { createDb, migrateDb } from \"./packages/db/dist/index.js\"; import { createEarlyInvestorEvidenceClient, runEarlyInvestorBatch } from \"./apps/scraper/dist/wallets/early-investors.js\"; const cfg=loadConfig(\"./config.yaml\").earlyInvestors; const handle=createDb(\"postgres://memefinder:memefinder@127.0.0.1:5432/memefinder\"); try { await migrateDb(handle.db); const result=await runEarlyInvestorBatch({db:handle.db,client:createEarlyInvestorEvidenceClient(),logError:(message)=>console.error(message),logWarn:(message)=>console.error(message)}, {references:cfg.references,confirmations:cfg.confirmations,earlyWindowBlocks:cfg.earlyWindowBlocks,blockWindow:cfg.blockWindow,maxWindowsPerCycle:cfg.maxWindowsPerCycle,maxLogsPerWindow:cfg.maxLogsPerWindow,maxTransactionsPerWindow:cfg.maxTransactionsPerWindow}); console.log(JSON.stringify(result)); if (result.failures>0 || !result.caughtUp) throw new Error(\"early-investor backfill did not complete\"); } finally { await handle.close(); }"], decision="allow")
prefix_rule(pattern=["mise", "exec", "--", "node", "--input-type=module", "-e", "import { loadConfig } from \"./packages/config/dist/index.js\"; import { createDb, migrateDb } from \"./packages/db/dist/index.js\"; import { runRobinhoodAddressActivityCollection } from \"./apps/scraper/dist/wallets/address-activity-collect.js\"; import { createRobinhoodBlockscoutAddressActivityClient } from \"./apps/scraper/dist/wallets/blockscout-activity.js\"; import { createRobinhoodReceiptActivityClient, runReceiptActivityCycle } from \"./apps/scraper/dist/wallets/classify-activity.js\"; const cfg=loadConfig(\"./config.yaml\"); const ac=cfg.wallets.robinhoodAddressActivity; const h=createDb(\"postgres://memefinder:memefinder@127.0.0.1:5432/memefinder\"); let failures=0; try { await migrateDb(h.db); const activityClient=createRobinhoodBlockscoutAddressActivityClient(); const receiptClient=createRobinhoodReceiptActivityClient(); let cycles=1; for (let cycle=1; cycle<=cycles; cycle+=1) { const a=await runRobinhoodAddressActivityCollection({db:h.db,client:activityClient,logError:(m)=>console.error(m)},{kols:cfg.kols,batchSize:ac.batchSize,maxPagesPerWallet:ac.maxPagesPerWallet}); if (cycle===1) cycles=Math.max(1,Math.ceil(a.eligibleWallets/ac.batchSize)); failures+=a.failures; const q=await runReceiptActivityCycle({db:h.db,client:receiptClient,logError:(m)=>console.error(m)},{batchSize:ac.receiptBatchSize,confirmations:ac.receiptConfirmations,maxAttempts:ac.receiptMaxAttempts,retryBaseSec:ac.receiptRetryBaseSec,retryMaxSec:ac.receiptRetryMaxSec}); failures+=q.failures; console.log(JSON.stringify({cycle,cycles,eligible:a.eligibleWallets,attempted:a.attemptedWallets,observations:a.observations,incomplete:a.incompleteWallets,activityFailures:a.failures,receiptTx:q.transactions,swaps:q.classifiedSwaps,transfers:q.classifiedTransfers,newTrades:q.newTrades,receiptFailures:q.failures,quarantined:q.quarantined})); } for (let drain=1; drain<=10; drain+=1) { const q=await runReceiptActivityCycle({db:h.db,client:receiptClient,logError:(m)=>console.error(m)},{batchSize:ac.receiptBatchSize,confirmations:ac.receiptConfirmations,maxAttempts:ac.receiptMaxAttempts,retryBaseSec:ac.receiptRetryBaseSec,retryMaxSec:ac.receiptRetryMaxSec}); failures+=q.failures; console.log(JSON.stringify({drain,receiptTx:q.transactions,swaps:q.classifiedSwaps,transfers:q.classifiedTransfers,newTrades:q.newTrades,receiptFailures:q.failures,quarantined:q.quarantined})); if (q.transactions===0) break; } if (failures>0) throw new Error(`wallet operational cycle failures=${failures}`); } finally { await h.close(); }"], decision="allow")
prefix_rule(pattern=["jq", "-c", "[.items[].type] | unique"], decision="allow")
prefix_rule(pattern=["jq", "-c", "{types:([.items[].type]|unique),next_page_params}"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "DATABASE_URL=postgres://memefinder:memefinder@127.0.0.1:5432/memefinder_codex_test mise exec -- pnpm exec vitest run apps/scraper/src/wallets/early-investors.test.ts apps/scraper/src/wallets/early-investors.db.test.ts apps/scraper/src/wallets/classify-activity.db.test.ts"], decision="allow")
prefix_rule(pattern=["mise", "exec", "--", "node", "--input-type=module", "-e", "import { loadConfig } from \"./packages/config/dist/index.js\"; import { createDb, migrateDb } from \"./packages/db/dist/index.js\"; import { createBlockscoutThrottle } from \"./apps/scraper/dist/holders/blockscout.js\"; import { runRobinhoodAddressActivityCollection } from \"./apps/scraper/dist/wallets/address-activity-collect.js\"; import { createRobinhoodBlockscoutAddressActivityClient } from \"./apps/scraper/dist/wallets/blockscout-activity.js\"; const cfg=loadConfig(\"./config.yaml\"); const ac=cfg.wallets.robinhoodAddressActivity; const h=createDb(\"postgres://memefinder:memefinder@127.0.0.1:5432/memefinder\"); let failures=0; try { await migrateDb(h.db); const client=createRobinhoodBlockscoutAddressActivityClient({throttle:createBlockscoutThrottle(1000)}); let cycles=1; for (let cycle=1; cycle<=cycles; cycle+=1) { const a=await runRobinhoodAddressActivityCollection({db:h.db,client,logError:(m)=>console.error(m)},{kols:cfg.kols,batchSize:ac.batchSize,maxPagesPerWallet:ac.maxPagesPerWallet}); if (cycle===1) cycles=Math.max(1,Math.ceil(a.eligibleWallets/ac.batchSize)); failures+=a.failures; console.log(JSON.stringify({cycle,cycles,eligible:a.eligibleWallets,attempted:a.attemptedWallets,observations:a.observations,incomplete:a.incompleteWallets,failures:a.failures,lastWalletId:a.lastWalletId})); } console.log(JSON.stringify({complete:true,failures})); } finally { await h.close(); }"], decision="allow")
prefix_rule(pattern=["mise", "exec", "--", "node", "--input-type=module", "-e", "import pg from \"pg\"; const c=new pg.Client({connectionString:\"postgres://memefinder:memefinder@127.0.0.1:5432/memefinder\"}); await c.connect(); const q=await c.query(\"select (select count(*)::int from wallet_transfer_observations) as observations, (select count(distinct wallet_id)::int from wallet_transfer_observations) as observed_wallets, (select count(distinct tx_hash)::int from wallet_transfer_observations where classification_state = 'pending') as pending_txs, (select count(*)::int from wallet_transfer_observations where classification_state = 'quarantined') as quarantined_rows, (select count(*)::int from wallet_labels where role = 'sniper_candidate' and status = 'candidate') as sniper_candidates, (select count(*)::int from coin_signal_observations where kind = 'bundle_analysis' and state = 'positive') as bundle_signals, (select count(*)::int from wallet_asset_trades where attribution = 'receipt_swap') as receipt_trades\"); console.log(JSON.stringify(q.rows[0])); await c.end();"], decision="allow")
