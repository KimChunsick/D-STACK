prefix_rule(pattern=["mise", "exec", "--", "node", "--input-type=module", "-e", "import pg from \"pg\"; const c=new pg.Client({connectionString:\"postgres://memefinder:memefinder@localhost:5432/memefinder\"}); await c.connect(); const q=async(name,sql)=>{const x=await c.query(sql); console.log(\"---\"+name+\"---\"); console.log(JSON.stringify(x.rows,null,2))}; await q(\"active-by-chain\", \"select coalesce(chain,\\u0027(null)\\u0027) chain,resolution,count(*)::int n from coins where dismissed_at is null group by 1,2 order by n desc\"); await q(\"recent-top\", \"with s as (select distinct on (coin_id) coin_id,tier,score,mentions_1h,mentions_6h,mentions_24h,channel_diversity,velocity,risk_flag_count,computed_at from analysis_snapshots order by coin_id,computed_at desc,id desc), m as (select distinct on (coin_id) coin_id,market_cap_usd,liquidity_usd,price_change_24h_pct,fetched_at from market_snapshots order by coin_id,fetched_at desc,id desc) select c.symbol,c.chain,c.resolution,s.tier,round(s.score::numeric,4) score,s.mentions_1h,s.mentions_6h,s.mentions_24h,s.channel_diversity,round(s.velocity::numeric,3) velocity,s.risk_flag_count,round(m.market_cap_usd::numeric,0) market_cap,round(m.liquidity_usd::numeric,0) liquidity,round(m.price_change_24h_pct::numeric,1) change24h,s.computed_at from coins c join s on s.coin_id=c.id left join m on m.coin_id=c.id where c.dismissed_at is null order by s.score desc limit 30\"); await q(\"btc-noise\", \"select c.id,c.symbol,c.chain,c.resolution,count(m.id)::int mentions,min(m.mentioned_at) first_mention,max(m.mentioned_at) last_mention from coins c left join mentions m on m.coin_id=c.id where upper(c.symbol) in (\\u0027BTC\\u0027,\\u0027ETH\\u0027,\\u0027SOL\\u0027,\\u0027USDT\\u0027,\\u0027USDC\\u0027) group by c.id,c.symbol,c.chain,c.resolution order by mentions desc\"); await q(\"promotion-lag\", \"select count(*)::int total,count(*) filter (where notified_at is not null)::int notified,count(*) filter (where notified_at is null)::int pending,round(avg(extract(epoch from (notified_at-occurred_at))) filter (where notified_at is not null)::numeric,1) avg_notify_sec,max(extract(epoch from (notified_at-occurred_at))) filter (where notified_at is not null)::int max_notify_sec from promotions\"); await q(\"freshness\", \"select (select max(computed_at) from analysis_snapshots) latest_analysis,(select max(fetched_at) from market_snapshots) latest_market\"); await c.end();"], decision="allow")
prefix_rule(pattern=["mise", "exec", "--", "node", "--input-type=module", "-e", "import pg from \"pg\"; const c=new pg.Client({connectionString:\"postgres://memefinder:memefinder@localhost:5432/memefinder\"}); await c.connect(); const q=async(name,sql)=>{const x=await c.query(sql); console.log(\"---\"+name+\"---\"); console.log(JSON.stringify(x.rows,null,2))}; await q(\"promotions-by-tier\", \"select to_tier,count(*)::int total,count(*) filter(where notified_at is not null)::int notified,count(*) filter(where notified_at is null)::int pending,round(avg(extract(epoch from(notified_at-occurred_at))) filter(where notified_at is not null)::numeric,1) avg_sec,max(extract(epoch from(notified_at-occurred_at))) filter(where notified_at is not null)::int max_sec from promotions group by to_tier order by to_tier\"); await q(\"recent-promotion-lag\", \"select count(*)::int total,count(*) filter(where notified_at is not null)::int notified,count(*) filter(where notified_at is null)::int pending,round(avg(extract(epoch from(notified_at-occurred_at))) filter(where notified_at is not null)::numeric,1) avg_sec,max(extract(epoch from(notified_at-occurred_at))) filter(where notified_at is not null)::int max_sec from promotions where occurred_at >= now()-interval \\u002724 hours\\u0027 and to_tier in (\\u0027probable\\u0027,\\u0027very_high\\u0027)\"); await q(\"duplicate-symbols\", \"select upper(symbol) symbol,count(*)::int rows,array_agg(coalesce(chain,\\u0027(null)\\u0027) order by id) chains from coins where dismissed_at is null group by upper(symbol) having count(*)>1 order by rows desc,symbol limit 20\"); await q(\"recent-universe-quality\", \"with latest as (select distinct on(coin_id) coin_id,market_cap_usd,fdv_usd,liquidity_usd,price_change_24h_pct from market_snapshots order by coin_id,fetched_at desc,id desc), recent as (select distinct coin_id from mentions where mentioned_at >= now()-interval \\u002748 hours\\u0027) select count(*)::int recent_coins,count(*) filter(where l.coin_id is null)::int no_market,count(*) filter(where coalesce(l.market_cap_usd,l.fdv_usd)>50000000)::int over_50m,count(*) filter(where l.price_change_24h_pct>150)::int already_pumped,count(*) filter(where l.liquidity_usd<20000)::int low_liquidity from recent r join coins c on c.id=r.coin_id and c.dismissed_at is null left join latest l on l.coin_id=r.coin_id\"); await q(\"notification-log\", \"select kind,count(*)::int n,min(sent_at) first_sent,max(sent_at) last_sent from notifications_log group by kind\"); await c.end();"], decision="allow")
prefix_rule(pattern=["mise", "exec", "--", "node", "--input-type=module", "-e", "import pg from 'pg'; const c=new pg.Client({connectionString:'postgres://memefinder:memefinder@127.0.0.1:5432/memefinder'}); await c.connect(); const r=await c.query(\\\"select id,symbol,name,chain,ca,resolution,first_seen_at,dismissed_at from coins where upper(symbol) in ('CASHCAT','CASHDOG') order by id\\\"); console.log(JSON.stringify(r.rows,null,2)); await c.end();"], decision="allow")
prefix_rule(pattern=["mise", "exec", "--", "node", "--input-type=module", "-e", "import pg from 'pg'; const c=new pg.Client({connectionString:'postgres://memefinder:memefinder@127.0.0.1:5432/memefinder'}); await c.connect(); const r=await c.query(\\\"select c.id,c.symbol,c.chain,c.ca,c.resolution,ms.price_usd,ms.market_cap_usd,ms.fdv_usd,ms.liquidity_usd,ms.volume_24h_usd,ms.risk_flags,ms.fetched_at,(select count(*)::int from mentions m where m.coin_id=c.id) mentions from coins c left join lateral (select * from market_snapshots x where x.coin_id=c.id order by fetched_at desc,id desc limit 1) ms on true where upper(c.symbol) in ('CASHCAT','CASHDOG') order by c.id\\\"); console.log(JSON.stringify(r.rows,null,2)); await c.end();"], decision="allow")
prefix_rule(pattern=["curl", "-sS", "--fail", "--max-time"], decision="allow")
prefix_rule(pattern=["mise", "exec", "--", "pnpm", "--filter", "@meme-finder/db", "exec", "node", "--input-type=module", "-e", "import pg from \"pg\"; const c=new pg.Client({connectionString:\"postgres://memefinder:memefinder@127.0.0.1:5432/postgres\"}); await c.connect(); const name=\"memefinder_codex_test\"; const exists=await c.query(\"select 1 from pg_database where datname=$1\",[name]); if(!exists.rowCount) await c.query(\"create database memefinder_codex_test\"); console.log(exists.rowCount?\"exists\":\"created\"); await c.end();"], decision="allow")
