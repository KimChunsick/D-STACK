prefix_rule(pattern=["mise", "exec", "--", "node", "--input-type=module", "-e", "import pg from \"pg\"; const c=new pg.Client({connectionString:\"postgres://memefinder:memefinder@127.0.0.1:5432/memefinder_codex_test\"}); await c.connect(); await c.query(\"begin\"); await c.query(\"select xa.id from x_accounts xa join x_posts xp on xp.account_id = xa.id where xp.canonical_post_id in ($$999999999999999999$$) order by xa.id for share of xa\"); await c.query(\"select xp.canonical_post_id from x_posts xp join x_accounts xa on xa.id = xp.account_id where xp.canonical_post_id in ($$999999999999999999$$) and xp.compliance_state = $$active$$ and xp.retracted_at is null and xp.withheld is null and xa.active = true and xa.compliance_state = $$active$$ and xa.retracted_at is null order by xp.canonical_post_id for share of xp\"); await c.query(\"rollback\"); await c.end(); console.log(\"lock queries ok\")"], decision="allow")
