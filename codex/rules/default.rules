prefix_rule(pattern=["mise", "exec", "--", "node", "--input-type=module", "-e", "import { loadConfig } from \"./packages/config/dist/index.js\"; import { createDb, migrateDb } from \"./packages/db/dist/index.js\"; import { createEarlyInvestorEvidenceClient, runEarlyInvestorBatch } from \"./apps/scraper/dist/wallets/early-investors.js\"; const cfg=loadConfig(\"./config.yaml\").earlyInvestors; const handle=createDb(\"postgres://memefinder:memefinder@127.0.0.1:5432/memefinder\"); let complete=false; try { await migrateDb(handle.db); const client=createEarlyInvestorEvidenceClient(); for (let cycle=1; cycle<=200; cycle+=1) { const result=await runEarlyInvestorBatch({db:handle.db,client,logError:(message)=>console.error(message),logWarn:(message)=>console.error(message)}, {references:cfg.references,confirmations:cfg.confirmations,earlyWindowBlocks:cfg.earlyWindowBlocks,blockWindow:cfg.blockWindow,maxWindowsPerCycle:cfg.maxWindowsPerCycle,maxLogsPerWindow:cfg.maxLogsPerWindow,maxTransactionsPerWindow:cfg.maxTransactionsPerWindow}); console.log(JSON.stringify({cycle,...result})); if (result.failures>0) throw new Error(\"early-investor reference failure\"); if (result.caughtUp) { complete=true; break; } } if (!complete) throw new Error(\"early-investor scan did not complete within 200 bounded cycles\"); } finally { await handle.close(); }"], decision="allow")
prefix_rule(pattern=["mise", "exec", "--", "node", "--input-type=module", "-e", "import pg from \"pg\"; const client=new pg.Client({connectionString:\"postgres://memefinder:memefinder@127.0.0.1:5432/memefinder\"}); await client.connect(); const result=await client.query(\"select key, value from cursors where key like early-investors:robinhood:% order by key\"); console.log(JSON.stringify(result.rows)); await client.end();"], decision="allow")
