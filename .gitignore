# ── Allowlist: deny everything at the top level by default… ──
/*

# …then re-include only curated top-level paths.
!/.gitignore
!/AGENTS.md
!/CLAUDE.md
!/README.md
!/THIRD-PARTY-NOTICES.md
!/install.sh
!/docs/
!/tests/
!/claude/
!/codex/
!/gemini/

# ── Inside each agent dir: deny-all, then re-include only curated entries ──
# Unanticipated names (claude/id_rsa, novel skill dirs, hook blobs) are denied here
# and never re-included — the allowlist stays a true allowlist at every level we can
# enumerate. hooks/ and rules/ are pinned to exact files; skills/ to exact skill dirs.
/claude/*
!/claude/.gitkeep
!/claude/CLAUDE.md
!/claude/settings.json
!/claude/statusline-command.sh
!/claude/ultracode.zsh
!/claude/hooks/
/claude/hooks/*
!/claude/hooks/fullcycle-inject.sh
!/claude/hooks/fullcycle-gate.sh
!/claude/skills/
/claude/skills/*
!/claude/skills/full-cycle/
!/claude/skills/codex-review/
!/claude/skills/codex-research/
!/claude/agents/
/claude/agents/*
!/claude/agents/frontend-dev.md
!/claude/agents/general-dev.md
!/claude/bin/
/claude/bin/*
!/claude/bin/dstack
/codex/*
!/codex/.gitkeep
!/codex/AGENTS.md
!/codex/instructions.md
!/codex/rules/
/codex/rules/*
!/codex/rules/default.rules
!/codex/skills/
/codex/skills/*
!/codex/skills/adversarial-review/
!/codex/skills/adversarial-research/
!/codex/skills/socratic-audit/
/gemini/*
!/gemini/.gitkeep
!/gemini/README.md

# ── Defense in depth: hard-deny secret/runtime names anywhere (incl. allowed subtrees) ──
# Backstops the one inherent wholesale surface: files *inside* a named skill dir.
**/auth.json
**/auth.json.*
**/credentials.json
**/*credentials*
**/*password*
**/.netrc
**/.netrc.*
**/id_rsa
**/id_rsa.*
**/id_dsa
**/id_dsa.*
**/id_ecdsa
**/id_ecdsa.*
**/id_ed25519
**/id_ed25519.*
**/*.pem
**/*.pem.*
**/*.key
**/*.key.*
**/*.p12
**/*.p12.*
**/*.pfx
**/*.pfx.*
**/*.token
**/*.token.*
**/*_token
**/*_token.*
**/*.secret
**/*.secret.*
**/*.sqlite
**/*.sqlite.*
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3.*
**/*.sqlite3-*
**/*.db
**/*.db.*
**/*.db-*
**/*.db3
**/*.db3.*
**/*.db3-*
**/*deploy_key*
**/history.jsonl
**/history.jsonl.*
**/config.toml
**/config.toml.*
**/.DS_Store
**/.DS_Store.*
**/sessions/
**/projects/
**/memory/
.env
.env.*
