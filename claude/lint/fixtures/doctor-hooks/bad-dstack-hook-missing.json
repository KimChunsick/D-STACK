{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "bash $HOME/.claude/hooks/dstack-hook.sh inject", "timeout": 15 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "bash $HOME/.claude/hooks/dstack-hook.sh stop", "timeout": 60 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Write|Edit|Bash", "hooks": [ { "type": "command", "command": "bash $HOME/.claude/hooks/dstack-hook.sh pre-write", "timeout": 20 } ] }
    ]
  }
}
