{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "bash -e -- $HOME/.claude/hooks/dstack-hook.sh inject", "timeout": 15 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "env X=1 bash $HOME/.claude/hooks/dstack-hook.sh stop", "timeout": 60 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Agent|Task", "hooks": [ { "type": "command", "command": "sh -c 'bash \"$HOME/.claude/hooks/dstack-hook.sh\" agent-model'", "timeout": 10 } ] },
      { "matcher": "Write|Edit|Bash", "hooks": [ { "type": "command", "command": "$HOME/.claude/hooks/dstack-hook.sh pre-write", "timeout": 20 } ] }
    ]
  }
}
